<Window x:Class="EmployeeClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="社員管理システム（ローカルDB接続）" Height="450" Width="650">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 入力フォーム -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="名前：" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtName" Width="100" Margin="5,0,15,0"/>

            <TextBlock Text="部署：" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtDepartment" Width="100" Margin="5,0,15,0"/>

            <TextBlock Text="入社日：" VerticalAlignment="Center"/>
            <DatePicker x:Name="DpHireDate" Width="120" Margin="5,0,0,0"/>
        </StackPanel>

        <!-- 操作ボタン -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="BtnAdd" Content="追加" Width="75" Margin="0,0,10,0" Click="BtnAdd_Click"/>
            <Button x:Name="BtnUpdate" Content="更新" Width="75" Margin="0,0,10,0" Click="BtnUpdate_Click"/>
            <Button x:Name="BtnDelete" Content="削除" Width="75" Margin="0,0,10,0" Click="BtnDelete_Click"/>
            <Button x:Name="BtnReload" Content="再読込" Width="75" Click="BtnReload_Click"/>
        </StackPanel>

        <!-- データ一覧表示 -->
        <DataGrid x:Name="GridEmployees" Grid.Row="2" AutoGenerateColumns="False" 
                  IsReadOnly="True" SelectionChanged="GridEmployees_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="名前" Binding="{Binding Name}" Width="150"/>
                <DataGridTextColumn Header="部署" Binding="{Binding Department}" Width="150"/>
                <DataGridTextColumn Header="入社日" Binding="{Binding HireDate, StringFormat=yyyy/MM/dd}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>